{
  "manifest_version": 3,
  "name": "LeetCode Tracker",
  "version": "2.0.5",
  "description": "Automatically sync accepted LeetCode submissions directly to your GitHub repository with intelligent categorization, streak analytics, and spaced practice tracking.",
  "author": "Ishank Mishra",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/logo-leetcode-tracker/Leetcode-tracker-16.png",
      "32": "assets/logo-leetcode-tracker/Leetcode-tracker-32.png",
      "48": "assets/logo-leetcode-tracker/Leetcode-tracker-48.png",
      "128": "assets/logo-leetcode-tracker/Leetcode-tracker-128.png"
    },
    "default_title": "LeetCode Tracker"
  },
  "icons": {
    "16": "assets/logo-leetcode-tracker/Leetcode-tracker-16.png",
    "32": "assets/logo-leetcode-tracker/Leetcode-tracker-32.png",
    "48": "assets/logo-leetcode-tracker/Leetcode-tracker-48.png",
    "128": "assets/logo-leetcode-tracker/Leetcode-tracker-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "*://leetcode.com/*",
    "https://api.github.com/*",
    "http://localhost:3000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://leetcode.com/problems/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "leetsync-pro@ishank.dev",
      "strict_min_version": "109.0"
    }
  }
}
